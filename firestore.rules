rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile isolation
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Trips subcollection isolation
      match /trips/{tripId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == uid;

        // Expenses subcollection isolation
        match /expenses/{expenseId} {
          allow read, write, delete: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Saved places subcollection isolation
      match /saved_places/{placeId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public catalog read access
    match /destinations/{destId} {
      allow read: if true;
      allow write: if false;

      match /attractions/{attractionId} {
        allow read: if true;
      }
      match /accommodations/{accId} {
        allow read: if true;
      }
      match /local_foods/{foodId} {
        allow read: if true;
      }
    }
  }
}
